{
  "name": "Coletor Auxiliar - Dazzling Axolotl",
  "version": "1.10.42",
  "manifest_version": 3,
  "description": "Coletor API-first com navegação visível pela extensão, OCR e IA progressivos somente quando necessários.",
  "permissions": [
    "tabs",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background-loader-1-10-42.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*.vercel.app/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "admin-bridge-v2.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.saipos.com/*",
        "https://livemenu.app/*",
        "https://*.anota.ai/*",
        "https://*.goomer.app/*",
        "https://*.goomer.com.br/*",
        "https://*.ola.click/*"
      ],
      "js": [
        "network-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "key": ""
}
